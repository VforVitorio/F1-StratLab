        <mxCell id="qt-history-title" value="RETIRED Qt implementation (historical comparison, commit 7ea6a7a6; no live broadcast connection)" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#A0A5B8;fontStyle=1;" vertex="1" parent="1">
