        <mxCell id="a-host-data" value="get_tick()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#06B6D4;strokeWidth=2;fontColor=#06B6D4;fontStyle=1;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dash-subs" target="tel-subs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- JSON reference arrow -->
        <mxCell id="a-broad-json" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#F59E0B;strokeWidth=1;dashed=1;" edge="1" parent="1" source="broadcast" target="json-block">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Subscribers -> widgets -->
        <mxCell id="a-ds-w" value="get_agents_view()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#F59E0B;strokeWidth=2;fontColor=#F59E0B;fontSize=10;" edge="1" parent="1" source="dash-subs" target="dash-wid">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a-ts-w" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#06B6D4;strokeWidth=2;" edge="1" parent="1" source="tel-subs" target="tel-wid">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Footer note -->
        <mxCell id="footer" value="Current path: one Arcade producer, one PITWALL host and TCP client, two independently polled views. No FastAPI or SSE." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#A0A5B8;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="360" y="850" width="1200" height="30" as="geometry"/>
        </mxCell>

