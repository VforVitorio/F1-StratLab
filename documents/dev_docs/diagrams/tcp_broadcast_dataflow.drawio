        </mxCell>
        <mxCell id="qt-history-client" value="RETIRED TelemetryWindow (QMainWindow)&#10;TelemetryStreamClient (QThread), separate socket&#10;consumed arcade.telemetry.{main, rival}; schema v2 replaced that shape" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A2138;strokeColor=#64748B;fontColor=#A0A5B8;fontSize=11;dashed=1;" vertex="1" parent="1">
