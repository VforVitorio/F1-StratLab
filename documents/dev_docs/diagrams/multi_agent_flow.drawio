        <mxCell id="mc_candidates" value="&lt;b&gt;4 Strategy Candidates&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;1. STAY_OUT&lt;br&gt;2. PIT_NOW&lt;br&gt;3. UNDERCUT&lt;br&gt;4. OVERCUT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#164e63;strokeColor=#22d3ee;fontColor=#cffafe;fontSize=10;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="820" y="160" width="200" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="mc_sim" value="&lt;b&gt;MC Scoring&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;500 shared draws across four candidates&lt;br&gt;N26 cliff · N27 SC · N28 pit / undercut&lt;br&gt;N25 pace_i sampled for RNG sequence, not scored&lt;br&gt;score = alpha * E[S] + (1-alpha) * P10[S]&lt;br&gt;finite gaps: positions gained + margin bonus&lt;br&gt;fallback: time_delta / POS_GAP_S equivalent&lt;br&gt;green / neutralised branches&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#164e63;strokeColor=#22d3ee;fontColor=#cffafe;fontSize=10;verticalAlign=top;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="820" y="260" width="300" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="e_cand_sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#22d3ee;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mc_candidates" target="mc_sim">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ============ LAYER 3: LLM SYNTHESIS ============ -->
        <mxCell id="layer3_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f0f2e;strokeColor=#f59e0b;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="440" width="340" height="200" as="geometry"/>
