        <!-- ============ LAYER 2: MONTE CARLO ============ -->
        <mxCell id="layer2_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f0f2e;strokeColor=#22d3ee;strokeWidth=1;dashed=1;" vertex="1" parent="1">
