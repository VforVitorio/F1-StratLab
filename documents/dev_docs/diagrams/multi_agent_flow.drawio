  <diagram id="n31-orchestration-flow" name="N31 Orchestration Flow">
    <mxGraphModel dx="1640" dy="780" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1680" pageHeight="760" math="0" shadow="0">
