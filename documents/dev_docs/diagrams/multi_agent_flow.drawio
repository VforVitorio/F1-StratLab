        </mxCell>
        <mxCell id="e_n27_moe" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#a855f7;strokeWidth=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n27" target="moe_diamond">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="405" y="320"/><mxPoint x="448" y="320"/></Array></mxGeometry>
