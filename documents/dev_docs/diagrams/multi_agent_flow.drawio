        </mxCell>
        <mxCell id="radio-agent" value="&lt;b&gt;N29 · Radio&lt;/b&gt;&lt;br&gt;radio / RCM events and alerts&lt;br&gt;reasoning goes to rich synthesis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17192b;strokeColor=#c44569;fontColor=#F5F5F5;fontSize=13;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="435" width="300" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="router" value="&lt;b&gt;Layer 1 · MoE routing&lt;/b&gt;&lt;br&gt;selects conditional agents from current race context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17192b;strokeColor=#3385ff;fontColor=#F5F5F5;fontSize=14;spacing=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="245" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="pit-agent" value="&lt;b&gt;N28 · Pit Strategy&lt;/b&gt;&lt;br&gt;N26 PIT_SOON · N29 PROBLEM/WARNING&lt;br&gt;or active SC/VSC · pit window · duration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17192b;strokeColor=#54A882;fontColor=#F5F5F5;fontSize=13;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="720" y="135" width="300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="rag-agent" value="&lt;b&gt;N30 · FIA RAG&lt;/b&gt;&lt;br&gt;N28 active · SC forecast · N29 warning/RCM penalty&lt;br&gt;or active SC/VSC · retrieved context for synthesis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17192b;strokeColor=#3385ff;fontColor=#F5F5F5;fontSize=13;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="720" y="335" width="300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="mc" value="&lt;b&gt;Layer 2 · Monte Carlo&lt;/b&gt;&lt;br&gt;500 draws per candidate from model distributions&lt;br&gt;score = α·E[S] + (1−α)·P10[S]&lt;br&gt;finite rival gaps: projected positions; otherwise legacy seconds fallback&lt;br&gt;STAY_OUT · PIT_NOW · UNDERCUT · OVERCUT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17192b;strokeColor=#6c5ce7;fontColor=#F5F5F5;fontSize=13;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="190" width="300" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="synthesis" value="&lt;b&gt;Layer 3 · LLM synthesis&lt;/b&gt;&lt;br&gt;combines agent reasoning, MC scores and retrieved FIA evidence&lt;br&gt;N30 informs the decision; it does not impose a universal action filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17192b;strokeColor=#b8915a;fontColor=#F5F5F5;fontSize=13;spacing=10;verticalAlign=middle;" vertex="1" parent="1">
