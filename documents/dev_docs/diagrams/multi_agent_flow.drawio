        <mxCell id="title" value="N31 · Multi-Agent Orchestration" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#F5F5F5;" vertex="1" parent="1">
          <mxGeometry x="60" y="35" width="1300" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="always-on" value="&lt;b&gt;N25-N27 model agents&lt;/b&gt;&lt;br&gt;RaceState / lap_state → Pace · Tyre&lt;br&gt;Race Situation distributions feed MC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17192b;strokeColor=#6c5ce7;fontColor=#F5F5F5;fontSize=14;spacing=12;verticalAlign=middle;" vertex="1" parent="1">
