        <mxCell id="n26" value="&lt;b&gt;N26, Tire Agent&lt;/b&gt;&#xa;LangGraph ReAct&#xa;───────────&#xa;@tool predict_tire_deg&#xa;@tool estimate_cliff&#xa;───────────&#xa;Output: TireOutput&#xa;laps_to_cliff P10/P50/P90&#xa;OK / MONITOR / PIT_SOON&#xa;deg_cost_s · cumulative_deg_s&#xa;reasoning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="230" y="484" width="170" height="176" as="geometry" />
        </mxCell>

        <mxCell id="n27" value="&lt;b&gt;N27, Race Situation&lt;/b&gt;&#xa;LangGraph ReAct&#xa;───────────&#xa;@tool predict_overtake&#xa;@tool predict_sc&#xa;───────────&#xa;Output: RaceSituationOutput&#xa;overtake_prob · sc_prob_3lap&#xa;sc_currently_active · vsc_active&#xa;reasoning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="484" width="162" height="176" as="geometry" />
