        <mxCell id="n25" value="&lt;b&gt;N25, Pace Agent&lt;/b&gt;&#xa;Direct XGBoost call (no LLM)&#xa;───────────&#xa;No tools or ReAct loop&#xa;Deterministic regression&#xa;───────────&#xa;Output: PaceOutput&#xa;lap_time_pred&#xa;delta_vs_prev · delta_vs_median&#xa;ci_p10 · ci_p90&#xa;reasoning → synthesis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
