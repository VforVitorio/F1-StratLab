        <mxCell id="n28" value="&lt;b&gt;N28, Pit Strategy&lt;/b&gt;&#xa;LangGraph ReAct&#xa;───────────&#xa;@tool predict_pit_dur&#xa;@tool score_undercut&#xa;@tool recommend_compound&#xa;───────────&#xa;Output: PitStrategyOutput&#xa;action · recommended_lap&#xa;compound_recommendation&#xa;p05/p50/p95 · undercut_prob&#xa;undercut_target · sc_reactive&#xa;reasoning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
