        <!-- ═══════════════════════════ N31 ORCHESTRATOR ═══════════════════════════ -->
        <mxCell id="n31_lbl" value="N31, Strategy Orchestrator (LangGraph multi-agent supervisor · Local/Cloud LLM)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="658" width="990" height="22" as="geometry" />
        </mxCell>

        <mxCell id="n31_l1" value="&lt;b&gt;Layer 1, Dynamic MoE Routing&lt;/b&gt;&lt;br/&gt;Always: N25 + N26 + N27 + N29&lt;br/&gt;N28: N26 PIT_SOON, N29 PROBLEM/WARNING, or active SC/VSC&lt;br/&gt;N30: N27 SC probability above configured threshold, N29 WARNING/RCM penalty, N28 active, or active SC/VSC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8d5f5;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="62" y="730" width="295" height="150" as="geometry" />
        </mxCell>

        <mxCell id="n31_l2" value="&lt;b&gt;Layer 2, Monte Carlo Simulation&lt;/b&gt;&lt;br/&gt;500 shared draws for four candidates&lt;br/&gt;N26 cliff ~ Triangular(P10/P50/P90)&lt;br/&gt;N27 SC ~ Bernoulli(sc_prob_3lap)&lt;br/&gt;N28 pit ~ Triangular(P05/P50/P95); ucut ~ Bernoulli(prob)&lt;br/&gt;N25 pace_i sampled for RNG sequence, not scored&lt;br/&gt;score = α·E[S] + (1−α)·P10[S]&lt;br/&gt;finite gaps: positions gained + margin bonus&lt;br/&gt;fallback: time_delta / POS_GAP_S equivalent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d8c5ed;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="367" y="730" width="308" height="150" as="geometry" />
        </mxCell>

        <mxCell id="n31_l3" value="&lt;b&gt;Layer 3, LLM Synthesis&lt;/b&gt;&lt;br/&gt;with_structured_output(_LLMSynthesis), 12 LLM fields&lt;br/&gt;N31 attaches scenario_scores + regulation_context&lt;br/&gt;N30 supplies retrieved evidence; it does not filter actions&lt;br/&gt;Output: 14-field StrategyRecommendation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8b0e0;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="685" y="730" width="328" height="150" as="geometry" />
        </mxCell>

